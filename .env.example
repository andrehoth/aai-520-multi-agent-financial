# Copy this file to .env and fill in your keys
# Never commit .env

# --- LLM (read by tools/llm.py) ---
# Optional. Defaults to "gemini", the only implemented provider. Supporting
# another provider requires a new _call_<provider>() function and a matching
# branch in call_llm().
LLM_PROVIDER=gemini

# Optional. Defaults to gemini-3.6-flash. Passed to the API as-is. If this model
# returns HTTP 503 (overloaded) or is unavailable, set another Gemini model ID
# here, and confirm it works with a single call_llm() test first.
LLM_MODEL=gemini-3.6-flash

# Required. Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# --- Data APIs (all free tiers) ---
# NewsAPI: https://newsapi.org
NEWSAPI_KEY=

# Alpha Vantage: https://www.alphavantage.co
# The free tier allows 25 requests per day. A full notebook run makes 2.
ALPHA_VANTAGE_KEY=

# FRED: https://fred.stlouisfed.org
FRED_API_KEY=